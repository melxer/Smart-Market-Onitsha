# GEMINI_API_KEY: Optional Gemini API key (configured via Secrets panel if needed).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="smart-market-dev-secret-change-in-production"

# SQLITE_DB_PATH: Path to the local SQLite database file (defaults to ./data/smart_market.db).
SQLITE_DB_PATH="./data/smart_market.db"
